{
  "name": "basura",
  "version": "5.0.0",
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "basura": "bin/basura.js"
  },
  "types": "types/index.d.ts",
  "files": [
    "bin/*",
    "data/data.json",
    "lib/*.js",
    "types/*"
  ],
  "scripts": {
    "clean": "rm -rf coverage docs types data/*.json lib/data.js",
    "lint": "eslint .",
    "data": "node tools/create.js",
    "docs": "typedoc",
    "snaps": "ava --update-snapshots",
    "coverage": "c8 npm test",
    "test": "ava",
    "types": "tsc",
    "build": "npm run types && npm run lint && npm run docs && npm run coverage && npm pack --dry-run"
  },
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "description": "Generate random JavaScript",
  "homepage": "https://github.com/hildjj/basura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hildjj/basura.git"
  },
  "bugs": {
    "url": "https://github.com/hildjj/basura/issues"
  },
  "keywords": [
    "test",
    "fuzzing",
    "random",
    "string",
    "URL",
    "json",
    "cbor"
  ],
  "license": "MIT",
  "dependencies": {
    "@cto.af/random": "3.0.0",
    "@cto.af/unicode-trie": "3.2.11",
    "@cto.af/unicode-trie-runtime": "3.2.11",
    "cbor2": "^2.4.1",
    "commander": "^15.0.0",
    "tlds2": "^2.2.19"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "^7.0.3",
    "@fast-csv/parse": "^5.0.8",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ava": "^8.1.0",
    "cbor-edn": "^0.2.2",
    "codepoints": "^1.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-ava": "^18.0.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "superc8": "^12.7.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  }
}
