{
  "include": ["lib/*.js", "lib/*.d.ts"],

  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "outDir": "types",
    "target": "ES2022",
    "rootDir": "./lib",
    "types": ["node"]
  }
}
